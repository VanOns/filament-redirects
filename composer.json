{
    "name": "van-ons/filament-redirects",
    "description": "Manage redirects in FilamentPHP",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "VanOns\\FilamentRedirects\\": "src/"
        }
    },
    "authors": [
        {
            "name": "Patrick",
            "email": "patrick@van-ons.nl"
        }
    ],
    "minimum-stability": "dev",
    "require": {
        "php": "^8.2",
        "illuminate/contracts": "^11.0|^12.0|^13.0",
        "filament/filament": "^4.0|^5.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.94.2",
        "phpstan/phpstan": "^2.1.42",
        "orchestra/testbench": "^11.0|^12.0|^13.0"
    },
    "scripts": {
        "fix": "vendor/bin/php-cs-fixer fix",
        "analyse": "vendor/bin/phpstan analyse"
    },
    "extra": {
        "laravel": {
            "providers": [
                "VanOns\\FilamentRedirects\\RedirectsServiceProvider"
            ]
        }
    }
}
