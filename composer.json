{
    "name": "van-ons/filament-redirects",
    "description": "Manage redirects in FilamentPHP",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "VanOns\\FilamentRedirects\\": "src/"
        }
    },
    "authors": [
        {
            "name": "Patrick",
            "email": "patrick@van-ons.nl"
        }
    ],
    "minimum-stability": "dev",
    "require": {
        "php": "^8.3",
        "illuminate/contracts": "^9.28|^10.0|^11.0|^12.0",
        "van-ons/laravel-redirector": "^0.2.0",
        "filament/filament": "^3.2"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "dev-master",
        "phpstan/phpstan": "2.0.x-dev",
        "orchestra/testbench": "10.x-dev"
    },
    "scripts": {
        "fix": "vendor/bin/php-cs-fixer fix",
        "analyse": "vendor/bin/phpstan analyse"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/VanOns/laravel-redirector"
        }
    ],
    "extra": {
        "laravel": {
            "providers": [
                "VanOns\\FilamentRedirects\\RedirectsServiceProvider"
            ]
        }
    }
}
